# Database
DATABASE_URL=sqlite:///./prompt_pursuit.db

# Modes
AUTH_MODE=mock
GENERATION_MODE=mock
SCORING_MODE=mock
STORAGE_MODE=local

# Supabase (Production)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

# Generation Settings
GENERATION_MODEL=flux-1-schnell
GENERATION_LOCK_TIMEOUT_SECONDS=120
MAX_PROMPT_LENGTH=1000
